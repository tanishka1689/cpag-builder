{
  "version": 2,
  "name": "cpag",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "functions": {
    "app/(builder)/cpag/api/ai/chat/route.ts": {
      "maxDuration": 300
    },
    "app/(builder)/cpag/api/project/export/route.ts": {
      "maxDuration": 300
    },
    "app/(builder)/cpag/api/**/*.ts": {
      "maxDuration": 300
    },
    "app/(builder)/cpag/mcp/*/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/airtable-webhooks",
      "schedule": "0 3 * * *"
    }
  ]
}


